#!/usr/bin/env bash
set -euo pipefail

CONN_INFO="${XDG_CONFIG_HOME:-$HOME/.config}/Local/graphql-connection-info.json"
SITES_JSON="${XDG_CONFIG_HOME:-$HOME/.config}/Local/sites.json"

if [[ ! -f "$CONN_INFO" ]]; then
  echo "Error: Local is not running (connection info not found)" >&2
  exit 1
fi

PORT=$(jq -r '.port' "$CONN_INFO")
TOKEN=$(jq -r '.authToken' "$CONN_INFO")
URL="http://127.0.0.1:${PORT}/graphql"

graphql() {
  curl -sf -X POST "$URL" \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer $TOKEN" \
    -d "$1"
}

list_sites() {
  graphql '{"query":"{ sites { id name status } }"}' | \
    jq -r '.data.sites[] | "\(.id)\t\(.name)\t\(.status)"'
}

start_site() {
  local id=$1
  graphql "{\"query\":\"mutation { startSite(id: \\\"$id\\\") { name status } }\"}" | \
    jq -r '.data.startSite | "\(.name) → \(.status)"'
}

stop_site() {
  local id=$1
  graphql "{\"query\":\"mutation { stopSite(id: \\\"$id\\\") { name status } }\"}" | \
    jq -r '.data.stopSite | "\(.name) → \(.status)"'
}

stop_all() {
  local running
  running=$(list_sites | awk -F'\t' '$3=="running" {print $1}')
  if [[ -z "$running" ]]; then
    echo "No running sites."
    return
  fi
  echo "$running" | while read -r id; do
    stop_site "$id"
  done
}

find_site_by_path() {
  local theme_path
  theme_path=$(realpath "${1:-$PWD}")

  jq -r 'to_entries[] | "\(.key)\t\(.value.name)\t\(.value.path)"' "$SITES_JSON" | \
    while IFS=$'\t' read -r id name path; do
      local expanded="${path/#\~/$HOME}"
      if [[ "$theme_path" == "$expanded"* ]]; then
        echo "$id"$'\t'"$name"
        return
      fi
    done
}

theme_toggle() {
  local dir="${1:-$PWD}"

  if [[ ! -f "$dir/functions.php" || ! -f "$dir/style.css" ]]; then
    echo "Error: not a WordPress theme directory (missing functions.php or style.css)" >&2
    exit 1
  fi

  local match
  match=$(find_site_by_path "$dir")

  if [[ -z "$match" ]]; then
    echo "Error: could not find a Local site for this theme path" >&2
    exit 1
  fi

  local id name status
  id=$(echo "$match" | cut -f1)
  name=$(echo "$match" | cut -f2)
  status=$(list_sites | awk -F'\t' -v id="$id" '$1==id {print $3}')

  echo "Site:   $name"
  echo "Status: $status"
  echo ""

  case "$status" in
    running)
      read -r -p "Stop site? [y/N] " confirm
      [[ "$confirm" =~ ^[Yy]$ ]] && stop_site "$id"
      ;;
    halted)
      read -r -p "Start site? [y/N] " confirm
      [[ "$confirm" =~ ^[Yy]$ ]] && start_site "$id"
      ;;
  esac
}

start_current() {
  local match id name status
  match=$(find_site_by_path "$PWD")
  if [[ -z "$match" ]]; then
    echo "No Local site found for current directory."
  else
    id=$(echo "$match" | cut -f1)
    name=$(echo "$match" | cut -f2)
    status=$(list_sites | awk -F'\t' -v id="$id" '$1==id {print $3}')
    if [[ "$status" == "running" ]]; then
      echo "Warning: '$name' is already running."
    else
      start_site "$id"
    fi
  fi
}

stop_current() {
  local match id name status
  match=$(find_site_by_path "$PWD")
  if [[ -z "$match" ]]; then
    echo "No Local site found for current directory."
  else
    id=$(echo "$match" | cut -f1)
    name=$(echo "$match" | cut -f2)
    status=$(list_sites | awk -F'\t' -v id="$id" '$1==id {print $3}')
    if [[ "$status" != "running" ]]; then
      echo "Warning: '$name' is not running."
    else
      stop_site "$id"
    fi
  fi
}

start_select() {
  local results
  results=$(list_sites | column -t -s $'\t' | \
    fzf --prompt="start site> " --height=40% --reverse --multi --bind "tab:toggle+down")
  if [[ -n "$results" ]]; then
    while IFS= read -r result; do
      start_site "$(echo "$result" | awk '{print $1}')"
    done <<< "$results"
  fi
}

search_site() {
  local query="${1:-}" all selected id name status path

  all=$(jq -r 'to_entries[] | "\(.key)\t\(.value.name)\t\(.value.path)"' "$SITES_JSON")
  if [[ -z "$all" ]]; then
    echo "No sites found."
    return
  fi

  selected=$(
    list_sites | awk -F'\t' '{print $1"\t"$2"\t"$3}' | \
    while IFS=$'\t' read -r sid sname sstatus; do
      spath=$(echo "$all" | awk -F'\t' -v id="$sid" '$1==id {print $3}')
      printf '%s\t%s\t%s\t%s\n' "$sid" "$sname" "$sstatus" "${spath/#\~/$HOME}"
    done | \
    fzf --prompt="search> " --height=50% --reverse \
        --query "$query" \
        --delimiter=$'\t' \
        --with-nth=2,3 \
        --preview='echo "ID:     {1}"; echo "Name:   {2}"; echo "Status: {3}"; echo "Path:   {4}"' \
        --preview-window=down:4:wrap
  )

  if [[ -n "$selected" ]]; then
    id=$(printf '%s' "$selected" | cut -f1)
    name=$(printf '%s' "$selected" | cut -f2)
    status=$(printf '%s' "$selected" | cut -f3)
    path=$(printf '%s' "$selected" | cut -f4)
    echo "Site:   $name"
    echo "Status: $status"
    echo "Path:   $path"
    echo ""
    case "$status" in
      running)
        read -r -p "Stop site? [y/N] " confirm
        [[ "$confirm" =~ ^[Yy]$ ]] && stop_site "$id"
        ;;
      halted)
        read -r -p "Start site? [y/N] " confirm
        [[ "$confirm" =~ ^[Yy]$ ]] && start_site "$id"
        ;;
    esac
  fi
}

stop_select() {
  local running results
  running=$(list_sites | awk -F'\t' '$3=="running"')
  if [[ -z "$running" ]]; then
    echo "No running sites to stop."
  else
    results=$(echo "$running" | column -t -s $'\t' | \
      fzf --prompt="stop site> " --height=40% --reverse --multi --bind "tab:toggle+down")
    if [[ -n "$results" ]]; then
      while IFS= read -r result; do
        stop_site "$(echo "$result" | awk '{print $1}')"
      done <<< "$results"
    fi
  fi
}

table_print() {
  awk -F'\t' '
    BEGIN { n=0 }
    { rows[n]=$0; for(i=1;i<=NF;i++) if(length($i)>w[i]) w[i]=length($i); n++ }
    function hline(l,m,r,   i,s,k,sep) {
      s=l
      for(i=1;i<=3;i++) {
        for(k=0;k<w[i]+2;k++) s=s "─"
        sep=(i<3?m:r); s=s sep
      }
      print s
    }
    END {
      hline("┌","┬","┐")
      split(rows[0],h,"\t")
      printf "│"; for(i=1;i<=3;i++) printf " \033[1m%-*s\033[0m │", w[i], h[i]; print ""
      hline("├","┼","┤")
      for(j=1;j<n;j++) {
        split(rows[j],d,"\t")
        printf "│"
        for(i=1;i<=3;i++) {
          if(i==3 && d[i]=="running") {
            pad=w[i]-length(d[i]); printf " \033[32m%s\033[0m", d[i]
            for(k=0;k<pad;k++) printf " "; printf " │"
          } else { printf " %-*s │", w[i], d[i] }
        }
        print ""
      }
      hline("└","┴","┘")
    }
  '
}

interactive() {
  while true; do
    # Show running sites
    local running
    running=$(list_sites | awk -F'\t' '$3=="running"')

    if [[ -n "$running" ]]; then
      echo "Running sites:"
      { printf 'ID\tName\tStatus\n'; echo "$running"; } | table_print
      echo ""
    else
      echo "No running sites."
      echo ""
    fi

    # Pick action
    local action
    action=$(printf 'Search\nStart Current\nStop Current\nStart by Select\nStop by Select\nStop All\nTheme toggle\nInstall\nExit' | \
      fzf --prompt="action> " --height=30% --reverse)

    case "$action" in
      "Search")
        search_site
        ;;
      "Start Current")
        start_current
        ;;
      "Stop Current")
        stop_current
        ;;
      "Start by Select")
        start_select
        ;;
      "Stop by Select")
        stop_select
        ;;
      "Stop All")
        stop_all
        ;;
      "Theme toggle")
        theme_toggle
        ;;
      Install)
        local install_dir="$HOME/.local/bin"
        mkdir -p "$install_dir"
        ln -sf "$(realpath "$0")" "$install_dir/local-cli"
        echo "Linked: $install_dir/local-cli → $(realpath "$0")"
        ;;
      Exit|"")
        exit 0
        ;;
    esac
  done
}

case "${1:-}" in
  search)
    search_site "${2:-}"
    ;;
  args)
    cat <<'EOF'
alias lcl="local-cli list"
alias lcsc="local-cli start-current"
alias lcfc="local-cli stop-current"
alias lcss="local-cli start-select"
alias lcfs="local-cli stop-select"
alias lcsa="local-cli stop-all"
alias lcse="local-cli search"
EOF
    ;;
  theme)
    theme_toggle "${2:-}"
    ;;
  list)
    list_sites
    ;;
  start-current)
    start_current
    ;;
  stop-current)
    stop_current
    ;;
  start-select)
    start_select
    ;;
  stop-select)
    stop_select
    ;;
  stop-all)
    stop_all
    ;;
  install)
    INSTALL_DIR="${2:-$HOME/.local/bin}"
    mkdir -p "$INSTALL_DIR"
    ln -sf "$(realpath "$0")" "$INSTALL_DIR/local-cli"
    echo "Linked: $INSTALL_DIR/local-cli → $(realpath "$0")"
    echo "Make sure $INSTALL_DIR is in your PATH"
    ;;
  help|-h|--help)
    echo "Usage: local-cli [command]"
    echo ""
    echo "Commands:"
    echo "  (none)        interactive mode"
    echo "  search [query] fuzzy-search all sites; select to start/stop"
    echo "  args           print shell aliases (eval \"\$(local-cli args)\")"
    echo "  theme [path]  detect site from theme dir and toggle start/stop"
    echo "  list          list all sites (id, name, status)"
    echo "  start-current start the site for the current directory"
    echo "  stop-current  stop the site for the current directory"
    echo "  start-select  pick site(s) to start via fzf"
    echo "  stop-select   pick running site(s) to stop via fzf"
    echo "  stop-all      stop all running sites"
    echo "  install       symlink local-cli to ~/.local/bin (or custom dir)"
    echo "  help          show this help"
    ;;
  *)
    interactive
    ;;
esac
